{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "drizzle",
    "worker-configuration.d.ts",
    ".agents/skills",
    ".claude/skills"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeCheck": true,
    "typeAware": true
  },
  "rules": {
    "typescript/no-deprecated": "error"
  },
  "env": {
    "builtin": true
  }
}
