{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pushnot",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO",
      },
    ],
  },
  "exports": {
    "SessionDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
