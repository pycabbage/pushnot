{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pushnot",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_als"],
  "main": "./src/index.tsx",
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO",
      },
    ],
  },
  "secrets": {
    "required": ["SESSION_SECRET", "VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY_JWK"],
  },
  "exports": {
    "SessionDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
